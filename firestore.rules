rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(casa) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/casas/$(casa)).data.membros;
    }

    // Cada pessoa guarda só qual casa ela usa.
    match /usuarios/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // A casa: quem sabe o código pode consultar e entrar; só membros mudam o resto.
    match /casas/{casa} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.membros == [request.auth.uid];
      allow update: if signedIn() && (
        request.auth.uid in resource.data.membros ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros']) &&
          request.resource.data.membros.hasAll(resource.data.membros) &&
          request.resource.data.membros.size() == resource.data.membros.size() + 1 &&
          request.auth.uid in request.resource.data.membros
        )
      );

      // Plano e lançamentos: só membros da casa leem e escrevem.
      match /dados/{doc} {
        allow read, write: if isMember(casa);
      }
    }
  }
}
